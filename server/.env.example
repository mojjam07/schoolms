NODE_ENV=development
PORT=4000

# Supabase: Project Settings > Database > Connection string.
# Use the "Session pooler" string (works over IPv4, needed on Render).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Exact origin of the frontend (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Email via Resend (https://resend.com). Leave RESEND_API_KEY empty in development to log emails instead.
# MAIL_FROM must use a domain you have verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
RESEND_API_KEY=
MAIL_FROM=[School Name] <onboarding@resend.dev>

# File storage. "local" writes to STORAGE_DIR (development only: Render's disk is wiped on redeploy).
# In production use "supabase" with a PRIVATE bucket. The service role key must stay on the server.
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=school-files

SCHOOL_NAME="School Name"
SCHOOL_ADDRESS="Full street address, Oshodi, Lagos"
SCHOOL_PHONE="08020600641"
SCHOOL_EMAIL="office@yourschool.example"

# Paystack (https://dashboard.paystack.com > Settings > API Keys & Webhooks). Server only, never in the frontend.
# Leave empty to switch online payment off: parents then see that it is unavailable.
# Use the TEST secret key (sk_test_...) until you are ready to take real money, then swap in the LIVE key (sk_live_...).
PAYSTACK_SECRET_KEY=
# Webhook URL to enter in the Paystack dashboard:  https://YOUR-API-HOST/api/webhooks/paystack
